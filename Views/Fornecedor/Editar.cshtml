@model EditarFornecedorViewModel

@{
    Layout = "_Layout";

    ViewBag.Title = "Editar Fornecedor";
}

<div class="row justify-content-start">
    <form class="col-lg-6" action="/Fornecedor/Editar/@Model.Id" method="post">
        <div class="text-danger" asp-validation-summary="ModelOnly"></div>
        <input asp-for="Id" type="hidden" />
        <div>
            <label class="form-label" for="Nome">Nome</label>
            <input type="text" class="form-control" asp-for="Nome" />
            <span class="text-danger" asp-validation-for="Nome"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" for="Telefone">Telefone</label>
            <input type="text" class="form-control" asp-for="Telefone" />
            <span class="text-danger" asp-validation-for="Telefone"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" for="Cnpj">CNPJ</label>
            <input type="text" class="form-control" asp-for="Cnpj" />
            <span class="text-danger" asp-validation-for="Cnpj"></span>
        </div>


        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Confirmar Edição</button>
            <a class="btn btn-secondary" href="/Fornecedor/Listar">Voltar para a lista de fornecedores</a>
        </div>

    </form>
</div>
