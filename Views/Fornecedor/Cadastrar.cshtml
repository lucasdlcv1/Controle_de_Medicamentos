@model CadastrarFornecedorViewModel

@{
    Layout = "_Layout";

    ViewBag.Title = "Cadastrar Fornecedor";
}
<div class="row justify-content-start">
    <form class="col-lg-6" action="/Fornecedor/Cadastrar" method="post">
        <div class="text-danger" asp-validation-summary="ModelOnly"></div>

        <div class="mt-4">
            <label class="form-label" for="Nome">Nome</label>
            <input type="text" class="form-control" id="Nome" name="Nome" />
            <span class="text-danger" asp-validation-for="Nome"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" for="Telefone">Telefone</label>
            <input type="text" class="form-control" id="Telefone" name="Telefone" />
            <span class="text-danger" asp-validation-for="Telefone"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" for="Cnpj">CNPJ</label>
            <input type="text" class="form-control" id="Cnpj" name="Cnpj" />
            <span class="text-danger" asp-validation-for="Cnpj"></span>
        </div>


        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check-circle"></i>
                Confirmar Cadastro
            </button>
            <a class="btn btn-secondary" href="/Fornecedor/Listar">
                <i class="bi bi-arrow-left"></i>
                Voltar para a lista de fornecedores
            </a>
        </div>

    </form>
</div>
