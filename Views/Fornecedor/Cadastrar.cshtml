@using ControleDeMedicamentos.WebApp.ModuloFornecedores

@model List<Fornecedor>

<h2>Cadastro de Fornecedor</h2>

<hr />
<a href="/">Início</a>
<a href="/Fornecedor/Listar">Fornecedores</a>
<hr />

<form action="/Fornecedor/Cadastrar" method="post">
    <div>
        <label for="Nome">Nome</label>
        <input type="text" id="Nome" name="Nome" />
    </div>

    <div>
        <label for="Telefone">Telefone</label>
        <input type="text" id="Telefone" name="Telefone" />
    </div>

    <div>
        <label for="Cnpj">CNPJ</label>
        <input type="text" id="Cnpj" name="Cnpj" />
    </div>



    <button type="submit">Cadastrar</button>
</form>

<p>
    <a href="/Fornecedor/Listar">Voltar para a lista de fornecedores</a>
</p>
