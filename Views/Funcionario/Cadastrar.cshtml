@model CadastrarFuncionarioViewModel


@{
    Layout = "_Layout";

    ViewBag.Title = "Cadastrar Funcionario";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Cadastrar" method="post">
        <div>
            <label class="form-label" for="Nome">Nome</label>
            <input type="text" class="form-control" id="Nome" name="Nome" />
        </div>

        <div class="mt-4">
            <label class="form-label" for="Telefone">Telefone</label>
            <input type="text" class="form-control" id="Telefone" name="Telefone" />
        </div>

        <div class="mt-4">
            <label class="form-label" for="Cpf">CPF</label>
            <input type="text" class="form-control" id="Cpf" name="Cpf" />
        </div>


        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check-circle"></i>
                Confirmar Cadastro
            </button>
            <a class="btn btn-secondary" href="/Funcionario/Listar">
                <i class="bi bi-arrow-left"></i>
                Voltar para a lista de funcionarios
            </a>
        </div>

    </form>
</div>
