@{
    Layout = "_Layout";

    ViewBag.Title = "Cadastro de Medicamento";
}

@model CadastrarMedicamentoViewModel;

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Cadastrar" method="post">

        <div>
            <label class="form-label" asp-for="Nome">Nome</label>
            <input class="form-control" type="text" asp-for="Nome" name="Nome" />
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Descricao">Descricao</label>
            <textarea class="form-control" asp-for="Descricao"></textarea>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="FornecedorId">Fornecedor</label>
            <select class="form-select" asp-for="FornecedorId">

                @foreach (FornecedorMedicamentoViewModel f in Model.Fornecedores)
                {
                    <option value="@f.Id"> @f.Nome</option>

                }
            </select>


        </div>



        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check-circle"></i>
                Confirmar Cadastro
            </button>
            <a class="btn btn-secondary" href="/Medicamento/Listar">
                <i class="bi bi-arrow-left"></i>
                Voltar para a lista de medicamentos
            </a>
        </div>
    </form>

</div>
