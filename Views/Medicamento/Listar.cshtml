@{
    Layout = "_Layout";

    ViewBag.Title = "Listagem de Medicamentos";
}

<p>
    <a href="Cadastrar">Cadastrar Medicamento</a>
</p>

<p>
    <a href="/Fornecedor/Cadastrar">Cadastrar Fornecedor</a>
</p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Descricao</th>
            <th>Fornecedor</th>
            <th>Quantidade em estoque</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var medicamento in Model)
        {
            <tr>
                <td>@medicamento.Id</td>
                <td>@medicamento.Nome</td>
                <td>@medicamento.Descricao</td>
                <td>@medicamento.Fornecedor.Nome</td>
                <td>@medicamento.QuantidadeEmEstoque</td>
                <td>
                    <a href="/Medicamento/Editar/@medicamento.Id">Editar</a>
                    <span> | </span>
                    <a href="/Medicamento/Excluir/@medicamento.Id">Excluir</a>
                </td>
            </tr>










        }
    </tbody>
</table>
