@model List<ListarMedicamentoViewModel>

@{
    Layout = "_Layout";

    ViewBag.Title = "Listagem de Medicamentos";
}

<p>
    <a class="btn btn-primary" asp-action="Cadastrar">
        <i class="bi bi-plus-circle"></i>
        Cadastrar Medicamento
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info mt-4" role="alert">
        Nenhum Medicamento cadastrado.
    </div>
}

else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">

        @foreach (ListarMedicamentoViewModel m in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5>@m.Nome</h5>
                            <span class="badge text-bg-secondary">@m.Id</span>
                        </div>

                        <p class="card-text">@m.Descricao</p>

                        <dl class="row mb-2">

                            <dt class="col-sm-8">Fornecedor</dt>
                            <dd class="col-sm-4">@m.NomeFornecedor</dd>

                            <dt class="col-sm-8">Quantidade em Estoque</dt>
                            <dd class="col-sm-2">@m.QuantidadeEmEstoque</dd>
                        </dl>

                        <div class="d-flex gap-2 justify-content-end mt-auto">
                            <a class="btn btn-sm btn-outline-primary" href="/Medicamento/Editar/@m.Id">
                                <i class="bi bi-pencil"></i>
                                Editar
                            </a>
                            <span> | </span>
                            <a class="btn btn-sm btn-outline-danger" href="/Medicamento/Excluir/@m.Id">
                                <i class="bi bi-trash"></i>
                                Excluir
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        }
    </div>
}

